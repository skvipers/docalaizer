# PostgreSQL
POSTGRES_USER=docalaizer
POSTGRES_PASSWORD=docalaizer_dev
POSTGRES_DB=docalaizer
POSTGRES_PORT=5439
DATABASE_URL=postgresql://docalaizer:docalaizer_dev@localhost:5439/docalaizer

# API & MCP server
API_PORT=3001
AUTH_SECRET=change-me-in-production-min-32-chars
ALLOW_PUBLIC_SIGNUP=false
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000

# Optional isolated PostgreSQL URL for running integration tests
# TEST_DATABASE_URL=postgresql://docalaizer:docalaizer_dev@localhost:5439/docalaizer_test

# Optional LocuGard v0.1.0 passkey authentication (HTTPS required)
# LOCUGARD_URL=https://locugard.home.arpa:8443
# LOCUGARD_ORIGIN=https://docalaizer.home.arpa:3000
# For a private LocuGard CA, set NODE_EXTRA_CA_CERTS to its root CA certificate.

# Web App
NEXT_PUBLIC_API_URL=http://localhost:3001
